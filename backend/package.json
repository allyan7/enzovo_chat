{
  "name": "enzovo_chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agentic e-commerce support chatbot: multi-agent (LangGraph) + MCP + RAG + memory, running on local Qwen via Ollama",
  "scripts": {
    "db:seed": "tsx models/seed.ts",
    "rag:index": "tsx modules/Knowledge/index-embeddings.ts",
    "mcp": "tsx mcp/enzovo.mcp.ts",
    "dev": "tsx watch api.ts",
    "start": "tsx api.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "validate:seed": "node models/validate-seed.mjs",
    "ci": "npm run validate:seed && npm run typecheck && npm test",
    "eval": "tsx evals/run.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@langchain/core": "^1.3.4",
    "@langchain/langgraph": "^1.6.1",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@langchain/mcp-adapters": "^2.0.2",
    "@langchain/ollama": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
