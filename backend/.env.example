# Local LLM (Ollama). Pull first: ollama pull qwen2.5:14b && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:14b
# Fast/cheap model for routing (can be the same model)
ROUTER_MODEL=qwen2.5:14b
EMBED_MODEL=nomic-embed-text

# SQLite files
DB_PATH=./enzovo.db
CHECKPOINT_DB_PATH=./checkpoints.db

# The seed data is written as of this date, so the demo stays consistent
ENZOVO_TODAY=2026-11-04

PORT=3000
